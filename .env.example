# Copie para .env e preencha. O .env fica só na máquina que roda o serviço.

# Token das rotas /api/media, com pelo menos 32 caracteres.
# Gere com: openssl rand -hex 24
DECKLIVE_ADMIN_TOKEN=

# Opcionais (padrões entre parênteses):
# DECKLIVE_SOURCE_API=https://api.yanlucas.com
# DECKLIVE_MEDIA_HOSTS=cdn.yanlucas.com
# RUST_LOG=decklive=info,tower_http=info

# Porta no loopback do host (8083). Lida pelo docker compose, não pelo serviço.
# DECKLIVE_PORT=8083
